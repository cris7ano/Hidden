    end
    if Utils then
        NumberUtils = require(Utils:FindFirstChild("NumberUtils"))
    end
    
    if not plotChannels or next(plotChannels) == nil then
        initializePlotScanner()
    end
    
    task.spawn(function()
        while task.wait(2) do
            if autoGrabEnabled then
                prebuildStealCallbacks()
