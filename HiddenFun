                -- Apply new mutation effects
                if State.AnimalMutation and State.AnimalMutation ~= "None" then
                    local mutationColor = _G.mutationColors[State.AnimalMutation]
                    if mutationColor then
                        for _, part in ipairs(state.spawned:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.Color = mutationColor
                                if State.AnimalMutation == "Gold" then
                                    part.Material = Enum.Material.Neon
                                    part.Reflectance = 0.3
                                elseif State.AnimalMutation == "Diamond" then
                                    part.Material = Enum.Material.ForceField
                                elseif State.AnimalMutation == "Lava" then
                                    part.Material = Enum.Material.Slate
                                elseif State.AnimalMutation == "Galaxy" then
                                    part.Material = Enum.Material.Neon
                                elseif State.AnimalMutation == "Radioactive" then
