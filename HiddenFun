end

local function getRootPart()
    local char = LocalPlayer.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
end

local function isValidPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local state = prompt:GetAttribute("State")
    local act = prompt.ActionText
    return state == "Steal" or state == "Grab" or act == "Steal" or act == "Grab"
end

local function getNearestStealable()
    local topPets = get_top_3_pets()
    local targetAnimal = nil
    
    if topPets[selectedBrainrotIndex] then
        targetAnimal = topPets[selectedBrainrotIndex].animalData
    end
    
    if not targetAnimal or isMyBaseAnimal(targetAnimal) then
        return nil
    end
    
    local prompt = PromptMemoryCache[targetAnimal.uid]
    if not prompt or not prompt.Parent then
        prompt = findProximityPromptForAnimal(targetAnimal)
    end
    
    return prompt
end

local function firePromptConnections(prompt, signalName)
    if signalName == "PromptButtonHoldBegan" then
        local ok, conns = pcall(getconnections, prompt.PromptButtonHoldBegan)
        if ok and type(conns) == "table" then
            for _, conn in ipairs(conns) do
                if type(conn.Function) == "function" then
                    task.spawn(conn.Function)
                end
            end
        end
    elseif signalName == "Triggered" then
        local ok, conns = pcall(getconnections, prompt.Triggered)
        if ok and type(conns) == "table" then
            for _, conn in ipairs(conns) do
                if type(conn.Function) == "function" then
                    task.spawn(conn.Function)
                end
            end
        end
    end
end

local function executeSteal(prompt)
    if autoGrabRunning or not prompt or not prompt.Parent then return end
    autoGrabRunning = true
    local itemName = (prompt.ObjectText ~= "" and prompt.ObjectText) or "item"
    if statusLabel then statusLabel.Text = itemName end
    if barFill then barFill.Size = UDim2.new(0, 0, 1, 0) end
    
    firePromptConnections(prompt, "PromptButtonHoldBegan")
    if barFill then TweenService:Create(barFill, TweenInfo.new(stealDelay, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 1, 0)}):Play() end
    
    -- Auto Giant Potion integration with Auto Grab - unequip at 92-93%, equip and activate at 95%
    if State.AutoGiantPotionWhenStealing then
        task.spawn(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end

            -- Wait until 92% then check distance
            task.wait(stealDelay * 0.92)

            -- Check distance before unequipping and using giant potion
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and prompt and prompt.Parent then
                local promptPosition = prompt.Parent.WorldPosition
                local hrpPos = hrp.Position
                -- Ignore vertical distance (Y axis) to account for being under the brainrot
                local horizontalDistance = math.sqrt((hrpPos.X - promptPosition.X)^2 + (hrpPos.Z - promptPosition.Z)^2)
                if horizontalDistance > 10 then
                    return -- Too far away, don't use giant potion
                end
            end

            -- Unequip any tool
            hum:UnequipTools()

            -- Equip and activate Giant Potion at 95%
            task.wait(stealDelay * 0.03)
            local potion = _G.getGiantPotionTool()
            if potion then
                hum:EquipTool(potion)
                task.wait(0.05)
                pcall(function()
                    potion:Activate()
                end)
                task.wait(0.1)
                hum:UnequipTools()
            end
        end)
    end
    
    task.wait(stealDelay)
    if prompt and prompt.Parent and prompt.Enabled then
        firePromptConnections(prompt, "Triggered")
    end
    if barFill then barFill.Size = UDim2.new(0, 0, 1, 0) end
    autoGrabRunning = false
end

function _G.AUTO_GRAB.Enable()
    if autoGrabEnabled then return end
    autoGrabEnabled = true
    
    local Packages = ReplicatedStorage:FindFirstChild("Packages")
    local Datas = ReplicatedStorage:FindFirstChild("Datas")
    local Shared = ReplicatedStorage:FindFirstChild("Shared")
    local Utils = ReplicatedStorage:FindFirstChild("Utils")
    
