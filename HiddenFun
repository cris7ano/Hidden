_G.findProximityPromptForAnimal = function(animalData)
    if not animalData then return nil end

    local cachedPrompt = PromptMemoryCache[animalData.uid]
    if cachedPrompt and cachedPrompt.Parent then
        return cachedPrompt
    end

    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local plot = plots:FindFirstChild(animalData.plot)
    if not plot then return nil end

    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return nil end

    local podium = podiums:FindFirstChild(animalData.slot)
    if not podium then return nil end

    local base = podium:FindFirstChild("Base")
    if not base then return nil end

    local spawn = base:FindFirstChild("Spawn")
    if not spawn then return nil end

    local attach = spawn:FindFirstChild("PromptAttachment")
    if not attach then return nil end

    for _, p in ipairs(attach:GetChildren()) do
        if p:IsA("ProximityPrompt") then
            PromptMemoryCache[animalData.uid] = p
            return p
        end
    end

    return nil
end

_G.isStealPrompt = function(prompt)
    local s = ""
    if prompt.ActionText then s = s .. " " .. prompt.ActionText end
    if prompt.ObjectText then s = s .. " " .. prompt.ObjectText end
    if prompt.Name then s = s .. " " .. prompt.Name end
    s = string.lower(s)
    return s:find("steal", 1, true) ~= nil
end

_G.buildStealCallbacks = function(prompt)
    if InternalStealCache[prompt] then return end

    local data = {
        holdCallbacks = {},
        triggerCallbacks = {},
        ready = true,
    }

    if (#data.holdCallbacks > 0) or (#data.triggerCallbacks > 0) then
        InternalStealCache[prompt] = data
    end
end

_G.executeInternalStealAsync = function(prompt, animalData)
    local data = InternalStealCache[prompt]
    if not data or not data.ready then return false end

    data.ready = false
    isStealing = true

    task.spawn(function()
        if #data.holdCallbacks > 0 then
            for _, fn in ipairs(data.holdCallbacks) do
                task.spawn(fn)
            end
        end

        local startTime = tick()
        local tpDone = false
        while tick() - startTime < 1.3 do
            stealProgress = (tick() - startTime) / 1.3
            if stealProgress >= 0.73 and not tpDone then
                tpDone = true
                local hrp = _G.getHRP()
                if hrp then
                    local d1 = (hrp.Position - pos1).Magnitude
                    local d2 = (hrp.Position - pos2).Magnitude
                    local isRight = d2 < d1
                    local sequence = isRight and spot2_sequence or spot1_sequence
                    hrp.CFrame = sequence[1]
                    task.wait(0.1)
                    hrp.CFrame = sequence[2]
                    task.wait(0.2)
                    local d1_new = (hrp.Position - pos1).Magnitude
                    local d2_new = (hrp.Position - pos2).Magnitude
                    hrp.CFrame = CFrame.new(d1_new < d2_new and pos1 or pos2)
                    -- Use Giant Potion on third teleport (from HiddenTeleport_Fixed)
                    if State and State.AutoGiantPotionWhenStealing then
                        useGiantPotion()
                    end
                end
            end
            task.wait(0.05)
        end

        if #data.triggerCallbacks > 0 then
            for _, fn in ipairs(data.triggerCallbacks) do
                task.spawn(fn)
            end
        end

        task.wait(0.1)
        data.ready = true
        task.wait(0.2)
        task.wait(0.1)
        isStealing = false
        stealProgress = 0
    end)

    return true
end

_G.attemptSteal = function(prompt, animalData)
    if not prompt or not prompt.Parent then return false end
    _G.buildStealCallbacks(prompt)
    if not InternalStealCache[prompt] then return false end
    return _G.executeInternalStealAsync(prompt, animalData)
end

_G.getNearestAnimal = function()
    local hrp = _G.getHRP()
    if not hrp then return nil end

    local nearest
    local minDist = math.huge

    for _, animalData in ipairs(allAnimalsCache) do
        if _G.isMyBase(animalData.plot) then
            continue
        end

        if animalData.worldPosition then
            local dist = (hrp.Position - animalData.worldPosition).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = animalData
            end
        end
    end

    return nearest
end

-- Auto Giant Potion System (from HiddenTeleport_Fixed)
local autoGiantPotionEnabled = true
local potionCooldown = 0
local potionCooldownTime = 3

local function useGiantPotion()
    if not autoGiantPotionEnabled then return false end

    local now = tick()
    if now - potionCooldown < potionCooldownTime then
        return false
    end

    local char = LocalPlayer.Character
    if not char then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false end

    -- Search for Giant Potion (multiple name variations)
    local potion = nil
    local potionNames = {"Giant_Potion", "Giant Potion", "GiantPotion", "Giant", "GrowthPotion", "BigPotion"}

    for _, name in ipairs(potionNames) do
        potion = char:FindFirstChild(name) or backpack:FindFirstChild(name)
        if potion then break end
    end

    -- Search for Flying Carpet
    local carpet = backpack:FindFirstChild("Flying Carpet") or char:FindFirstChild("Flying Carpet")

    if potion and potion:IsA("Tool") and carpet and carpet:IsA("Tool") then
        -- Unequip any currently equipped tool
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                tool.Parent = backpack
            end
        end
        
        -- Rapid equip glitch - equip both rapidly to bug them together
        for i = 1, 5 do
            pcall(function()
                carpet.Parent = char
                potion.Parent = char
            end)
            task.wait()
        end

        -- Try to activate the potion
        local success = pcall(function()
            potion:Activate()
        end)

        if success then
            potionCooldown = now
            return true
        end
    else
        -- Try remote event for potion
        local remoteNames = {"UseGiantPotion", "GiantPotion", "ActivateGiant", "PotionRemote"}
        for _, name in ipairs(remoteNames) do
            local remote = ReplicatedStorage:FindFirstChild(name)
            if remote and remote:IsA("RemoteEvent") then
                pcall(function() remote:FireServer() end)
                potionCooldown = now
                return true
            end
        end
    end
    return false
end

