            if obj:IsA("TextLabel") then
                if obj.Text and (obj.Text:lower():find("balloon") or obj.Text:lower():find("jump higher")) then
                    if _G.insta_reset then
                        _G.insta_reset()
                    end
                end
            end
        end)

        -- Also check existing TextLabels
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("TextLabel") then
                if obj.Text and (obj.Text:lower():find("balloon") or obj.Text:lower():find("jump higher")) then
