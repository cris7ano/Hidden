_G.GAME_STRETCHER = {}
local gameStretcherEnabled = false
local gameStretcherConnection = nil
local resConnection = nil

function _G.GAME_STRETCHER.Enable()
    gameStretcherEnabled = true
    if gameStretcherConnection then gameStretcherConnection:Disconnect() end
    gameStretcherConnection = RunService.RenderStepped:Connect(function()
        if not gameStretcherEnabled then return end
        local cam = Workspace.CurrentCamera
        if cam then cam.FieldOfView = 100 end
    end)
    resConnection = RunService.RenderStepped:Connect(function()
        local cam = Workspace.CurrentCamera
        if cam then
            cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, 0.7, 0, 0, 0, 1)
        end
    end)
end

function _G.GAME_STRETCHER.Disable()
    gameStretcherEnabled = false
    if gameStretcherConnection then
        gameStretcherConnection:Disconnect()
        gameStretcherConnection = nil
    end
    if resConnection then
        resConnection:Disconnect()
        resConnection = nil
    end
    local cam = Workspace.CurrentCamera
    if cam then cam.FieldOfView = State.CameraFOV end
end

