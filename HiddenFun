        _G.giantBackpack = LocalPlayer:FindFirstChild("Backpack")
        _G.potionNames = {"Giant_Potion", "Giant Potion", "GiantPotion", "Giant", "GrowthPotion", "BigPotion"}

        for _, name in ipairs(_G.potionNames) do
            if _G.giantChar then
                _G.giantTool = _G.giantChar:FindFirstChild(name)
                if _G.giantTool and _G.giantTool:IsA("Tool") then return _G.giantTool end
            end
            if _G.giantBackpack then
                _G.giantTool = _G.giantBackpack:FindFirstChild(name)
                if _G.giantTool and _G.giantTool:IsA("Tool") then return _G.giantTool end
