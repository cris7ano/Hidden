-- Inf Money Visual Functions
_G.originalMoneyText = nil
_G.moneyTextLabel = nil

_G.applyInfMoneyVisual = function()
    _G.infMoneyEnabled = true
    State.InfMoneyEnabled = true
    
    -- Find TextLabels with $ that are green/lime green
    pcall(function()
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Text and obj.Text:find("$") and not obj.Name:lower():find("hidden") then
                local color = obj.TextColor3
                -- Check if color is green/lime green (high green, low red/blue)
                if color.G > 0.5 and color.R < 0.5 and color.B < 0.5 then
                    _G.moneyTextLabel = obj
                    _G.originalMoneyText = obj.Text
                    obj.Text = "$100.00QA"
                    break
                end
            end
        end
    end)
end

_G.revertInfMoneyVisual = function()
    _G.infMoneyEnabled = false
    State.InfMoneyEnabled = false
    
    -- Restore original money text
    pcall(function()
        if _G.moneyTextLabel and _G.originalMoneyText then
            _G.moneyTextLabel.Text = _G.originalMoneyText
        end
        _G.moneyTextLabel = nil
        _G.originalMoneyText = nil
    end)
end

-- Function 1: Number formatting
local function formatNumber(num)
    if _G.infMoneyEnabled then
        return "$100.00QA"
    end
    if num >= 1000000 then
        return string.format("%.1fM", num / 1000000)
    elseif num >= 1000 then
        return string.format("%.1fK", num / 1000)
    else
        return tostring(math.floor(num))
    end
end

-- Function 2: Clamp value between min and max
local function clamp(val, min, max)
    return math.max(min, math.min(max, val))
end

-- Function 3: Linear interpolation
local function lerp(a, b, t)
    return a + (b - a) * clamp(t, 0, 1)
end

