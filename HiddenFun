-- getPing function
_G.getPing = function()
    local success, result = pcall(function()
        local networkStats = Stats:FindFirstChild("Network")
        if networkStats then
            -- Method 1: DataPing
            local serverStats = networkStats:FindFirstChild("ServerStats")
            if serverStats then
                local dataPing = serverStats:FindFirstChild("DataPing")
                if dataPing then
                    return math.floor(dataPing:GetValue())
                end
            end
            -- Method 2: Direct Ping property
            local ping = networkStats:FindFirstChild("Ping")
            if ping then
                return math.floor(ping:GetValue())
            end
        end
        -- Method 3: Use PerformanceStats
        local perfStats = Stats:FindFirstChild("PerformanceStats")
        if perfStats then
            local pingStat = perfStats:FindFirstChild("Ping")
            if pingStat then
                return math.floor(pingStat:GetValue())
            end
        end
        return 0
    end)
    return success and result or 0
end

_G.startStatsLoop = function()
    _G.statsFrameCount = 0
    _G.statsLastTime = tick()

    RunService.RenderStepped:Connect(function()
        _G.statsFrameCount = _G.statsFrameCount + 1
        _G.statsCurrentTime = tick()

        if _G.statsCurrentTime - _G.statsLastTime >= 1 then
            _G.statsFps = _G.statsFrameCount
            _G.statsFrameCount = 0
            _G.statsLastTime = _G.statsCurrentTime

            _G.statsPing = _G.getPing()

            if UI.StatsLabel then
                UI.StatsLabel.Text = string.format("FPS: %d | PING: %dms", _G.statsFps, _G.statsPing)
            end
        end
    end)

    -- Base Defender uses global 'core' table defined at module level

    _G.CARPET_ITEMS = {
        ["Flying Carpet"] = true,
        ["Witch's Broom"] = true,
        ["Santa's Sleigh"] = true
    }

    -- Admin functions removed

    local function findPlayerInHitbox()
        _G.hitbox = core.StealHitbox
        if not _G.hitbox then return end

        _G.hitboxCf = _G.hitbox.CFrame
        _G.hitboxSize = _G.hitbox.Size
        _G.hx, _G.hz = _G.hitboxSize.X * 0.5, _G.hitboxSize.Z * 0.5

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                _G.hitboxChar = p.Character
                if _G.hitboxChar then
                    _G.hitboxHrp = _G.hitboxChar:FindFirstChild("HumanoidRootPart")
                    if _G.hitboxHrp then
                        _G.hitboxRel = _G.hitboxCf:PointToObjectSpace(_G.hitboxHrp.Position)
                        if math.abs(_G.hitboxRel.X) <= _G.hx and math.abs(_G.hitboxRel.Z) <= _G.hz then
                            for _, item in ipairs(_G.hitboxChar:GetChildren()) do
                                if _G.CARPET_ITEMS[item.Name] then
                                    -- Admin punish removed
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Find Plot
    task.spawn(function()
        while task.wait(0.5) do
