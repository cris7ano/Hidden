-- ═══════════════════════════════════════════════
_G.AIMBOT_LASER_CAPE = {}
local aimbotEnabled = false
local aimbotRange = 350
local aimbotCurrentTarget = nil
local aimbotConnections = {}
local Net = nil
local PlayerMouse = nil

local function getNet()
    if not Net then
        pcall(function()
            Net = require(ReplicatedStorage:WaitForChild("Packages").Net)
        end)
    end
    return Net
end

local function getPlayerMouse()
    if not PlayerMouse then
        pcall(function()
            PlayerMouse = require(ReplicatedStorage:WaitForChild("Packages").PlayerMouse)
        end)
    end
    return PlayerMouse
end

local function getNearestAimbotTarget()
    if not aimbotEnabled or not LocalPlayer.Character then return nil end
    local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local nearest, shortest = nil, aimbotRange
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (pl.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
            if dist < shortest then
                shortest = dist
                nearest = pl
            end
        end
    end
    return nearest
end

local function getAimbotTargetPosition()
    if aimbotCurrentTarget and aimbotCurrentTarget.Character then
        local targetPart = aimbotCurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            or aimbotCurrentTarget.Character:FindFirstChild("Head")
            or aimbotCurrentTarget.Character:FindFirstChild("UpperTorso")
        if targetPart then
            return targetPart.Position, targetPart
        end
    end
    return nil, nil
end

local function fireAimbot()
    if not aimbotEnabled then return false end
    local targetPos, targetPart = getAimbotTargetPosition()
    if targetPart then
        local net = getNet()
        if net then
            net:RemoteEvent("UseItem"):FireServer(targetPos, targetPart)
            return true
        end
    end
    return false
end

local function hookAimbotTool(tool)
    -- Check if this is a Laser Cape tool
    if tool.Name == "Laser Cape" or tool:FindFirstChild("LaserCapeScript") then
        -- Hook the Activated event
        local originalActivated = tool.Activated
        tool.Activated:Connect(function()
            if aimbotEnabled then
                fireAimbot()
            end
        end)
    end
end

function _G.AIMBOT_LASER_CAPE.Enable()
    if aimbotEnabled then return end
    aimbotEnabled = true

    -- Initialize Net and PlayerMouse
    getNet()
    getPlayerMouse()

    if LocalPlayer.Character then
        for _, child in ipairs(LocalPlayer.Character:GetChildren()) do
            if child:IsA("Tool") then hookAimbotTool(child) end
        end
    end

    local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        for _, child in ipairs(newChar:GetChildren()) do
            if child:IsA("Tool") then hookAimbotTool(child) end
        end
    end)
    table.insert(aimbotConnections, charAddedConn)

    local descAddedConn = Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Tool") and obj:IsDescendantOf(LocalPlayer.Character) then
            task.wait(0.1)
            hookAimbotTool(obj)
        end
    end)
    table.insert(aimbotConnections, descAddedConn)

    local heartbeatConn = RunService.Heartbeat:Connect(function()
        if aimbotEnabled then
            aimbotCurrentTarget = getNearestAimbotTarget()
        end
    end)
    table.insert(aimbotConnections, heartbeatConn)
end

function _G.AIMBOT_LASER_CAPE.Disable()
    if not aimbotEnabled then return end
    aimbotEnabled = false
    aimbotCurrentTarget = nil

    for _, conn in ipairs(aimbotConnections) do
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    aimbotConnections = {}
end

