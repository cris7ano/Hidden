_G.ANTI_ADMIN_RAGDOLL = {}
local antiAdminRagdollEnabled = false
local promptConnections = {}

local function executeAntiAdminRagdoll(prompt)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- Check if Auto Grab is enabled and add distance check
    if autoGrabEnabled and prompt then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local promptPosition = prompt.Parent.WorldPosition
            local distance = (hrp.Position - promptPosition).Magnitude
            if distance > 7 then
                return -- Don't activate if more than 7 studs away when Auto Grab is enabled
            end
        end
    end

    local giantPotion = _G.getGiantPotionTool()

    if giantPotion and giantPotion:IsA("Tool") then
        hum:EquipTool(giantPotion)
        task.wait()
        giantPotion:Activate()
    end

    task.wait(0.01)

    -- Directly set humanoid to ragdoll state
    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Ragdoll)
    end)

    -- Also try platformstand as backup
    pcall(function()
        hum.PlatformStand = true
    end)

    -- Method 1: Use HiddenSpammer's fireCmd method
    local function getAdminPanelButtons()
        local adminGui = LocalPlayer.PlayerGui:FindFirstChild("AdminGui")
        if not adminGui then return nil, nil end
        local content = adminGui:FindFirstChild("Content")
        local profiles = adminGui:FindFirstChild("Profiles")
        if not content or not profiles then return nil, nil end
        local csf = content:FindFirstChild("ScrollingFrame")
        local psf = profiles:FindFirstChild("ScrollingFrame")
        return csf, psf
    end

    local csf, psf = getAdminPanelButtons()
    if csf and psf then
        local pb = psf:FindFirstChild(LocalPlayer.Name)
        local cb = csf:FindFirstChild("ragdoll")
        if pb and cb and getconnections then
            local pconns = getconnections(pb.Activated)
            local cconns = getconnections(cb.Activated)
            for _, c in ipairs(cconns) do if c.Function then task.spawn(c.Function) end end
            for _, c in ipairs(pconns) do if c.Function then task.spawn(c.Function) end end
        end
    end

    -- Method 2: Try the old admin remote
    if core.AdminRemote then
        pcall(function()
            core.AdminRemote:InvokeServer("f888ee6e-c86d-46e1-93d7-0639d6635d42", LocalPlayer, "ragdoll")
        end)
    end
end

function _G.ANTI_ADMIN_RAGDOLL.Enable()
    if antiAdminRagdollEnabled then return end
    antiAdminRagdollEnabled = true
    
    local function setupPrompt(prompt)
        if promptConnections[prompt] then return end
        
        local holdBegan = prompt.PromptButtonHoldBegan:Connect(function()
            if not antiAdminRagdollEnabled then return end
            local duration = prompt.HoldDuration
            local targetTime = duration * (autoGrabEnabled and 0.89 or 0.95)
            
            task.delay(targetTime, function()
                if antiAdminRagdollEnabled and prompt.Enabled then
                    executeAntiAdminRagdoll(prompt)
                end
            end)
        end)
        
        promptConnections[prompt] = holdBegan
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local actionText = obj.ActionText
            if actionText == "Steal" or actionText == "Grab" then
                setupPrompt(obj)
            end
        end
    end
    
    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("ProximityPrompt") and antiAdminRagdollEnabled then
            local actionText = obj.ActionText
            if actionText == "Steal" or actionText == "Grab" then
                setupPrompt(obj)
            end
        end
    end)
end

function _G.ANTI_ADMIN_RAGDOLL.Disable()
    antiAdminRagdollEnabled = false
    for prompt, connection in pairs(promptConnections) do
        if connection then
            connection:Disconnect()
        end
    end
    promptConnections = {}
end

