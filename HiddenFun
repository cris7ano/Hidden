        if _G.SS.stealMethod == "Prime" then
            local prompt = pod and pod.prompt
            if not prompt or not prompt.Parent then return end
            prompt.RequiresLineOfSight = false
            prompt.MaxActivationDistance = math.huge
            _G.SS_equipCarpet()
