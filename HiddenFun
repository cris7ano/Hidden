    -- Always run, check state each frame
    RunService.RenderStepped:Connect(function()
        -- Steal Speed (velocity-based)
        if State.StealSpeedEnabled then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.MoveDirection.Magnitude > 0 then
                    local dir = hum.MoveDirection.Unit
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        dir.X * State.BoosterStealSpeed,
                        hrp.AssemblyLinearVelocity.Y,
                        dir.Z * State.BoosterStealSpeed
                    )
                end
            end
        end

        -- Jump Power
        if State.WalkSpeedEnabled then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.UseJumpPower = true
                    hum.JumpPower = State.BoosterWalkSpeed
                end
            end
        end
    end)

