    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 30)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 20)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 30))
    })
    gradient.Rotation = 45
    gradient.Parent = stroke
    
    return stroke
end

_G.createAnimatedStroke = function(parent, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "AnimatedStroke"
    stroke.Thickness = thickness or 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    
    local gradient = Instance.new("UIGradient")
    gradient.Name = "StrokeGradient"
    -- Blue to Purple to Blue loop
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 30)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 120, 20)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 150, 30)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 120, 20)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 30))
    })
    gradient.Rotation = 0
    gradient.Parent = stroke
    
    -- Animate the gradient rotation
    task.spawn(function()
        while parent and parent.Parent do
            for i = 0, 360, 1 do
                if not gradient or not gradient.Parent then return end
                gradient.Rotation = i
                task.wait(0.01)
            end
        end
    end)
    
    return stroke
end

