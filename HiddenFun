    -- Listen for new descendants to apply xray
    if xrayConnection then xrayConnection:Disconnect() end
    xrayConnection = Workspace.DescendantAdded:Connect(function(obj)
        if State.XrayEnabled then
            applyXrayToObj(obj)
        end
    end)
end

local function disableXray()
    for part, value in pairs(originalTransparency) do
        if part then part.LocalTransparencyModifier = value end
    end
    originalTransparency = {}
    if xrayConnection then xrayConnection:Disconnect(); xrayConnection = nil end
end

-- Friend Allow ESP
local friendESPByPlot = {}
local friendESPRefreshConn = nil

local function clearFriendESP()
    for _, entry in pairs(friendESPByPlot) do
        if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
        if entry.connections then
            for _, conn in ipairs(entry.connections) do
                pcall(function() conn:Disconnect() end)
            end
        end
    end
    friendESPByPlot = {}
    State.friendESPObjects = {}
end

-- ActionText = what happens on use; ObjectText is usually a static label ("Allow Friends")
local function isFriendsAllowedOnPlot(friendPanel, main, prompt)
    local attr = friendPanel:GetAttribute("FriendsAllowed")
    if attr == nil then attr = main:GetAttribute("FriendsAllowed") end
    if attr == true then return true end
    if attr == false then return false end

    for _, name in ipairs({"FriendsAllowed", "Allowed", "FriendsEnabled"}) do
        local v = friendPanel:FindFirstChild(name, true) or main:FindFirstChild(name, true)
        if v and v:IsA("BoolValue") then return v.Value end
    end

    if prompt then
        local action = string.lower(prompt.ActionText or "")
        local object = string.lower(prompt.ObjectText or "")
        if action:find("disallow") or object == "disallow friends" then
            return true
        end
        if action:find("allow") then
            return false
        end
        -- ObjectText is often the static label "Allow Friends"; ActionText holds the verb
        if object == "allow friends" and action == "" then
            return true
        end
    end

    for _, desc in ipairs(friendPanel:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local raw = desc.Text or ""
            local t = string.lower(raw)
            if raw == "Disallow Friends" or t == "disallow friends" then return true end
            if raw == "Allow Friends" or t == "allow friends" then return false end
        end
    end

    return nil
end

local function updateFriendESPForPlot(plot)
    if not plot:IsA("Model") then return end
    local friendPanel = plot:FindFirstChild("FriendPanel")
    if not friendPanel then return end
    local main = friendPanel:FindFirstChild("Main")
    if not main then return end
    local prompt = main:FindFirstChildOfClass("ProximityPrompt")

    local isAllowed = isFriendsAllowedOnPlot(friendPanel, main, prompt)
    if isAllowed == nil then isAllowed = false end

    local entry = friendESPByPlot[plot]
    if not entry then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "HiddenFun_FriendESP"
        billboard.Adornee = main
        billboard.Size = UDim2.new(0, 18, 0, 18)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = main

        local symbol = Instance.new("TextLabel")
        symbol.Name = "Symbol"
        symbol.Size = UDim2.new(1, 0, 1, 0)
        symbol.BackgroundTransparency = 1
        symbol.Font = Enum.Font.GothamBold
        symbol.TextSize = 18
        symbol.Parent = billboard

        entry = { billboard = billboard, symbol = symbol, connections = {} }
        friendESPByPlot[plot] = entry
        table.insert(State.friendESPObjects, billboard)

        if prompt then
            local function refresh()
                if State.friendESPEnabled then updateFriendESPForPlot(plot) end
            end
            table.insert(entry.connections, prompt:GetPropertyChangedSignal("ActionText"):Connect(refresh))
            table.insert(entry.connections, prompt:GetPropertyChangedSignal("ObjectText"):Connect(refresh))
        end
    end

    entry.symbol.Text = isAllowed and "✓" or "x"
    entry.symbol.TextColor3 = isAllowed and Color3.fromRGB(60, 255, 100) or Color3.fromRGB(255, 60, 60)
end

local function refreshAllFriendESP()
    if not State.friendESPEnabled then return end
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return end
    for _, plot in ipairs(plots:GetChildren()) do
        updateFriendESPForPlot(plot)
    end
end

local function startFriendESP()
    State.friendESPEnabled = true
    clearFriendESP()
    refreshAllFriendESP()
    if friendESPRefreshConn then friendESPRefreshConn:Disconnect() end
    friendESPRefreshConn = RunService.Heartbeat:Connect(function()
        if not State.friendESPEnabled then return end
        if not _G._HiddenFunFriendESPNext or tick() >= _G._HiddenFunFriendESPNext then
            _G._HiddenFunFriendESPNext = tick() + 2
            refreshAllFriendESP()
        end
    end)
end

local function stopFriendESP()
    State.friendESPEnabled = false
    if friendESPRefreshConn then
        friendESPRefreshConn:Disconnect()
        friendESPRefreshConn = nil
    end
    clearFriendESP()
end

