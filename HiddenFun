-- Brainrot transparency (no GUI — auto 70% on all brainrots)
_G.initBrainrotTransparency = function()
    _G.BRAINROT_TRANSPARENCY = 0.7
    _G.trackedParts = {}
    _G.brainrotNames = {}

    _G.registerBrainrotName = function(name)
        if name and name ~= "" then
            _G.brainrotNames[name] = true
        end
    end

    _G.brainrotExisting = PlayerGui:FindFirstChild("BrainrotUI")
    if _G.brainrotExisting then _G.brainrotExisting:Destroy() end

    _G.checkAndTrack = function(obj)
        if obj:IsA("BasePart") or obj:IsA("Decal") then
            _G.brainrotNextParent = obj.Parent
            while _G.brainrotNextParent and _G.brainrotNextParent ~= Workspace do
                -- Exclude Animal Helper spawned animals
                if _G.brainrotNextParent:GetAttribute("AnimalHelperSpawned") then
                    break
                end
                -- Exclude player's character
                if _G.brainrotNextParent == LocalPlayer.Character then
                    break
                end
                -- Apply transparency to all models with Humanoid or AnimationController (spawned via Animals module)
                if _G.brainrotNextParent:IsA("Model") and (_G.brainrotNextParent:FindFirstChildOfClass("Humanoid") or _G.brainrotNextParent:FindFirstChildOfClass("AnimationController")) then
                    _G.trackedParts[obj] = true
                    obj.LocalTransparencyModifier = _G.BRAINROT_TRANSPARENCY
                    break
                end
                _G.brainrotNextParent = _G.brainrotNextParent.Parent
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        for obj in pairs(_G.trackedParts) do
            if obj and obj.Parent then
                obj.LocalTransparencyModifier = _G.BRAINROT_TRANSPARENCY
            else
                _G.trackedParts[obj] = nil
            end
        end
    end)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        _G.checkAndTrack(obj)
    end
    Workspace.DescendantAdded:Connect(_G.checkAndTrack)
end

