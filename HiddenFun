        _G.activatePotion = _G.getGiantPotionTool()
        if _G.activatePotion and _G.activatePotion:IsA("Tool") then
            if _G.activatePotion.Parent ~= _G.activateChar then
                _G.activateHum:EquipTool(_G.activatePotion)
                task.wait(0.1)
