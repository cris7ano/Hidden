    -- Generic spawn function for any animal
    _G.spawnAnimal = function(animalName, skipAnimation)
        local config = nil
        for _, animal in ipairs(_G.AnimalConfig) do
            if animal.name == animalName then
                config = animal
                break
            end
        end
        if not config then return end

        local state = _G.AnimalState[animalName]
        if state.spawned then return end

        local sharedAnimals
        pcall(function()
            sharedAnimals = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animals"))
        end)

        local spawnSuccess = false
        if sharedAnimals and type(sharedAnimals.GetAnimatedModel) == "function" then
            local success, model = pcall(function()
                return sharedAnimals:GetAnimatedModel(config.name, "Walk")
            end)

            if success and model then
                state.spawned = model
                spawnSuccess = true
            end
        end

        if not spawnSuccess then return end

        -- Mark as Animal Helper spawned to exclude from brainrot transparency
        state.spawned:SetAttribute("AnimalHelperSpawned", true)

        -- Scale the model
        state.spawned:ScaleTo(config.scale)

        -- Apply mutation effects (like HiddenDupe)
        local appliedRealVisuals = false
        if sharedAnimals and type(sharedAnimals.ApplyMutation) == "function" and State.AnimalMutation and State.AnimalMutation ~= "None" then
            pcall(function()
                sharedAnimals:ApplyMutation(state.spawned, config.name, State.AnimalMutation)
                appliedRealVisuals = true
            end)
        end

        -- Fallback: simple tint if we couldn't use SharedAnimals
        if not appliedRealVisuals and State.AnimalMutation and State.AnimalMutation ~= "None" then
            local mutationColor = _G.mutationColors[State.AnimalMutation]
            if mutationColor then
                for _, part in ipairs(state.spawned:GetDescendants()) do
                    if part:IsA("BasePart") then
                        -- Apply mutation color to parts
                        part.Color = mutationColor
                        -- For special mutations, add additional effects
                        if State.AnimalMutation == "Gold" then
                            part.Material = Enum.Material.Neon
                            part.Reflectance = 0.3
                        elseif State.AnimalMutation == "Diamond" then
                            part.Material = Enum.Material.ForceField
                            part.Transparency = State.AnimalTransparency
                        elseif State.AnimalMutation == "Lava" then
                            part.Material = Enum.Material.Slate
                        elseif State.AnimalMutation == "Galaxy" then
                            part.Material = Enum.Material.Neon
                        elseif State.AnimalMutation == "Radioactive" then
                            part.Material = Enum.Material.Neon
                        elseif State.AnimalMutation == "Cyber" then
                            part.Material = Enum.Material.Neon
                        elseif State.AnimalMutation == "Phantom" then
                            part.Material = Enum.Material.ForceField
                            part.Transparency = 0.5
                        elseif State.AnimalMutation == "Rainbow" then
                            -- Rainbow needs special handling - don't just use solid color
                            part.Material = Enum.Material.Neon
                        end
                    elseif part:IsA("Texture") or part:IsA("Decal") then
                        -- Remove original textures for mutations
                        part:Destroy()
                    end
                end
            end
        end

        -- Set all parts to anchored and non-collidable
        for _, part in ipairs(state.spawned:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
            end
        end

        -- Remove any billboards
        for _, desc in ipairs(state.spawned:GetDescendants()) do
            if desc:IsA("BillboardGui") then
                desc:Destroy()
            end
        end

        -- Set PrimaryPart if not already set
        if not state.spawned.PrimaryPart then
            for _, part in ipairs(state.spawned:GetDescendants()) do
                if part:IsA("BasePart") then
                    state.spawned.PrimaryPart = part
                    break
                end
            end
        end

        -- Load animations
        pcall(function()
            local animRoot = ReplicatedStorage:WaitForChild("Animations", 5):WaitForChild("Animals", 5)
            local animFolder = animRoot and animRoot:FindFirstChild(config.name)
            if animFolder then
                local controller = state.spawned:FindFirstChildWhichIsA("Humanoid") or state.spawned:FindFirstChildWhichIsA("AnimationController")
                if not controller then
                    controller = Instance.new("AnimationController")
                    controller.Parent = state.spawned
                end
                local animator = controller:FindFirstChildWhichIsA("Animator")
                if not animator then
                    animator = Instance.new("Animator")
                    animator.Parent = controller
                end

                -- Load walk animation
                local walkAnim = animFolder:FindFirstChild("Walk")
                if walkAnim and walkAnim:IsA("Animation") then
                    state.walkAnimTrack = animator:LoadAnimation(walkAnim)
                    state.walkAnimTrack.Looped = true
                end

                -- Load idle animation (using HiddenDupe method)
                local idleAnim = animFolder:FindFirstChild("Idle")
                if idleAnim and idleAnim:IsA("Animation") then
                    state.idleAnimTrack = animator:LoadAnimation(idleAnim)
                    state.idleAnimTrack.Looped = true
                    state.idleAnimTrack:Play()
                end

                -- Start with walk animation by default
                if state.walkAnimTrack then
                    state.walkAnimTrack:Play()
                    state.animTrack = state.walkAnimTrack
                elseif state.idleAnimTrack then
                    state.idleAnimTrack:Play()
                    state.animTrack = state.idleAnimTrack
                end
            end
        end)

        state.spawned.Parent = Workspace

        -- Animated spawn: fall from above to target position
        -- Skip animation if skipAnimation flag is true
        if skipAnimation then
            -- Instant placement
            task.spawn(function()
                local model = state.spawned
                local character = LocalPlayer.Character
                if not character or not model then return end
                
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                -- Calculate target position based on AnimalPosition setting
                local targetPosition
                local rightVector = hrp.CFrame.RightVector
                local upVector = hrp.CFrame.UpVector
                local lookVector = hrp.CFrame.LookVector
                
                if State.AnimalPosition == "Shoulder" then
                    local shoulderOffset = rightVector * config.offset.right + upVector * config.offset.up + lookVector * config.offset.look
                    targetPosition = hrp.Position + shoulderOffset
                elseif State.AnimalPosition == "Lower Ground" then
                    local rightLegOffset = rightVector * 1.5 + upVector * -1
                    targetPosition = hrp.Position + rightLegOffset
                elseif State.AnimalPosition == "Right Ground" then
                    local rightLegOffset = rightVector * 2.5 + upVector * 0
                    targetPosition = hrp.Position + rightLegOffset
                elseif State.AnimalPosition == "Ground" then
                    local rightLegOffset = rightVector * 3.0 + upVector * -0.5
                    targetPosition = hrp.Position + rightLegOffset
                else
                    local rightLegOffset = rightVector * 3.0 + upVector * -0.5
                    targetPosition = hrp.Position + rightLegOffset
                end
                
                local targetCFrame = CFrame.new(targetPosition)
                if model.PrimaryPart then
                    model:SetPrimaryPartCFrame(targetCFrame)
                else
                    model:PivotTo(targetCFrame)
                end
            end)
        else
            -- Animated spawn: fall from above to target position
            task.spawn(function()
                local model = state.spawned
                local character = LocalPlayer.Character
                if not character or not model then return end
                
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                -- Calculate target position based on AnimalPosition setting
                local targetPosition
                local rightVector = hrp.CFrame.RightVector
                local upVector = hrp.CFrame.UpVector
                local lookVector = hrp.CFrame.LookVector
                
                if State.AnimalPosition == "Shoulder" then
                    local shoulderOffset = rightVector * config.offset.right + upVector * config.offset.up + lookVector * config.offset.look
                    targetPosition = hrp.Position + shoulderOffset
                elseif State.AnimalPosition == "Lower Ground" then
                    local rightLegOffset = rightVector * 1.5 + upVector * -1
                    targetPosition = hrp.Position + rightLegOffset
                elseif State.AnimalPosition == "Right Ground" then
                    local rightLegOffset = rightVector * 2.5 + upVector * 0
                    targetPosition = hrp.Position + rightLegOffset
                elseif State.AnimalPosition == "Ground" then
                    local rightLegOffset = rightVector * 3.0 + upVector * -0.5
                    targetPosition = hrp.Position + rightLegOffset
                else
                    local rightLegOffset = rightVector * 3.0 + upVector * -0.5
                    targetPosition = hrp.Position + rightLegOffset
                end
                
                -- Start from above
                local startPosition = Vector3.new(targetPosition.X, targetPosition.Y + 30, targetPosition.Z)
                local startCFrame = CFrame.new(startPosition)
                
                if model.PrimaryPart then
                    model:SetPrimaryPartCFrame(startCFrame)
                else
                    model:PivotTo(startCFrame)
                end
                
                -- Fall animation
                local duration = 0.8
                local startTime = tick()
                
                while tick() - startTime < duration and model and model.Parent do
                    local elapsed = tick() - startTime
                    local progress = elapsed / duration
                    
                    -- Ease out cubic for smooth landing
                    local easedProgress = 1 - math.pow(1 - progress, 3)
                    
                    local currentY = startPosition.Y - (startPosition.Y - targetPosition.Y) * easedProgress
                    local currentCFrame = CFrame.new(targetPosition.X, currentY, targetPosition.Z)
                    
                    if model.PrimaryPart then
                        model:SetPrimaryPartCFrame(currentCFrame)
                    else
                        model:PivotTo(currentCFrame)
                    end
                    
                    task.wait()
                end
                
                -- Ensure final position is correct
                if model and model.Parent then
                    local finalCFrame = CFrame.new(targetPosition)
                    if model.PrimaryPart then
                        model:SetPrimaryPartCFrame(finalCFrame)
                    else
                        model:PivotTo(finalCFrame)
                    end
                end
            end)
        end

        -- Start follow loop with idle detection
        state.followConnection = RunService.RenderStepped:Connect(function()
            _G.afCharacter = LocalPlayer.Character
            if not _G.afCharacter or not state.spawned then return end

            _G.afHumanoidRootPart = _G.afCharacter:FindFirstChild("HumanoidRootPart")
            _G.afHumanoid = _G.afCharacter:FindFirstChildOfClass("Humanoid")
            _G.afHead = _G.afCharacter:FindFirstChild("Head")

            if _G.afHumanoidRootPart and _G.afHead then
                -- Check if player is moving
                _G.afIsMoving = _G.afHumanoid and _G.afHumanoid.MoveDirection.Magnitude > 0

                -- Handle animation switching based on movement
                if config.useIdleWhenStill then
                    if _G.afIsMoving and state.idleAnimTrack and state.idleAnimTrack.IsPlaying then
                        state.idleAnimTrack:Stop()
                        if state.walkAnimTrack then
                            state.walkAnimTrack:Play()
                            state.animTrack = state.walkAnimTrack
                        end
                    elseif not _G.afIsMoving and state.walkAnimTrack and state.walkAnimTrack.IsPlaying then
                        state.walkAnimTrack:Stop()
                        if state.idleAnimTrack then
                            state.idleAnimTrack:Play()
                            state.animTrack = state.idleAnimTrack
                        end
                    end
                end

                -- Help You feature: Check if holding a proximity prompt
                local holdingPrompt = false
                local promptPosition = nil

                if State.AnimalHelpYouEnabled then
                    -- Check if user is holding E (interaction key)
                    local isHoldingE = UserInputService:IsKeyDown(Enum.KeyCode.E)

                    if isHoldingE then
                        -- Find nearest proximity prompt within range
                        local nearestPrompt = nil
                        local nearestDist = 25

                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj:IsA("ProximityPrompt") and obj.Enabled then
                                -- Get the position of the prompt's parent
                                local promptParent = obj.Parent
                                local promptPos = nil

                                if promptParent then
                                    if promptParent:IsA("BasePart") then
                                        promptPos = promptParent.Position
                                    elseif promptParent:IsA("Model") and promptParent.PrimaryPart then
                                        promptPos = promptParent.PrimaryPart.Position
                                    elseif promptParent:IsA("Attachment") then
                                        promptPos = promptParent.WorldPosition
                                    elseif promptParent:IsA("MeshPart") then
                                        promptPos = promptParent.Position
                                    elseif promptParent:IsA("Part") then
                                        promptPos = promptParent.Position
                                    elseif promptParent:IsA("UnionOperation") then
                                        promptPos = promptParent.Position
                                    end
                                end

                                if promptPos then
                                    local dist = (_G.afHumanoidRootPart.Position - promptPos).Magnitude
                                    local maxDist = math.max(obj.MaxActivationDistance, 25)
                                    if dist < nearestDist and dist < maxDist then
                                        nearestDist = dist
                                        nearestPrompt = obj
                                        promptPosition = promptPos
                                    end
                                end
                            end
                        end

                        -- If holding E and near a prompt, send animal there
                        if nearestPrompt and promptPosition then
                            holdingPrompt = true
                        end
                    end
                end

                -- Calculate position based on AnimalPosition setting or prompt
                _G.afRightVector = _G.afHumanoidRootPart.CFrame.RightVector
                _G.afUpVector = _G.afHumanoidRootPart.CFrame.UpVector
                _G.afLookVector = _G.afHumanoidRootPart.CFrame.LookVector

                if holdingPrompt and promptPosition then
                    -- Fly to proximity prompt position
                    _G.afTargetPosition = promptPosition + Vector3.new(0, 2, 0)
                elseif State.AnimalPosition == "Shoulder" then
                    _G.afShoulderOffset = _G.afRightVector * config.offset.right + _G.afUpVector * config.offset.up + _G.afLookVector * config.offset.look
                    _G.afTargetPosition = _G.afHumanoidRootPart.Position + _G.afShoulderOffset
                elseif State.AnimalPosition == "Lower Ground" then
                    -- Lower Ground position - place next to right leg but lower
                    _G.afRightLegOffset = _G.afRightVector * 1.5 + _G.afUpVector * -1
                    _G.afTargetPosition = _G.afHumanoidRootPart.Position + _G.afRightLegOffset
                elseif State.AnimalPosition == "Right Ground" then
                    -- Right Ground position - place further to the right
                    _G.afRightLegOffset = _G.afRightVector * 2.5 + _G.afUpVector * 0
                    _G.afTargetPosition = _G.afHumanoidRootPart.Position + _G.afRightLegOffset
                elseif State.AnimalPosition == "Ground" then
                    -- Ground position - place more down and to the right
                    _G.afRightLegOffset = _G.afRightVector * 3.0 + _G.afUpVector * -0.5
                    _G.afTargetPosition = _G.afHumanoidRootPart.Position + _G.afRightLegOffset
                else
                    -- Default to Ground if position is not recognized
                    _G.afRightLegOffset = _G.afRightVector * 3.0 + _G.afUpVector * -0.5
                    _G.afTargetPosition = _G.afHumanoidRootPart.Position + _G.afRightLegOffset
                end

                -- Keep the model upright
                _G.afTargetCFrame = CFrame.new(_G.afTargetPosition) * CFrame.Angles(0, math.rad(_G.afHumanoidRootPart.Orientation.Y), 0)

                -- Smooth interpolation (faster when flying to prompt)
                local lerpSpeed = holdingPrompt and 0.3 or 0.1
                if state.spawned.PrimaryPart then
                    _G.afCurrentCFrame = state.spawned.PrimaryPart.CFrame
                else
                    _G.afCurrentCFrame = state.spawned:GetPivot()
                end

                _G.afSmoothedCFrame = _G.afCurrentCFrame:Lerp(_G.afTargetCFrame, lerpSpeed)

                -- Move the model
                if state.spawned.PrimaryPart then
                    state.spawned:SetPrimaryPartCFrame(_G.afSmoothedCFrame)
                else
                    state.spawned:PivotTo(_G.afSmoothedCFrame)
                end
            end
        end)
    end

    -- Generic despawn function for any animal with animation
    _G.despawnAnimal = function(animalName, skipAnimation)
        local state = _G.AnimalState[animalName]
        if not state then return end

        if state.followConnection then
            state.followConnection:Disconnect()
            state.followConnection = nil
        end
        if state.walkAnimTrack then
            state.walkAnimTrack:Stop()
            state.walkAnimTrack = nil
        end
        if state.idleAnimTrack then
            state.idleAnimTrack:Stop()
            state.idleAnimTrack = nil
        end
        if state.animTrack then
            state.animTrack:Stop()
            state.animTrack = nil
        end
        
        -- Animated despawn: spin and rise like a coin with fade out
        -- Skip animation if skipAnimation flag is true
        if state.spawned then
            if skipAnimation then
                -- Instant destroy
                state.spawned:Destroy()
                state.spawned = nil
            else
                state.isDespawning = true
                local originalTransparency = State.AnimalTransparency
                task.spawn(function()
                    local model = state.spawned
                    local duration = 1.0
                    local startTime = tick()
                    local startCFrame = model:GetPivot()
                    local startY = startCFrame.Position.Y
                    local targetY = startY + 20
                    
                    while tick() - startTime < duration and model and model.Parent do
                        local elapsed = tick() - startTime
                        local progress = elapsed / duration
                        
                        -- Spin faster as it goes up (ease in)
                        local spinSpeed = progress * 20 -- increases from 0 to 20 rotations
                        local rotation = CFrame.Angles(0, math.rad(spinSpeed * 360 * elapsed), 0)
                        
                        -- Rise up
                        local currentY = startY + (targetY - startY) * progress
                        local currentCFrame = CFrame.new(startCFrame.Position.X, currentY, startCFrame.Position.Z) * rotation
                        
                        if model.PrimaryPart then
                            model:SetPrimaryPartCFrame(currentCFrame)
                        else
                            model:PivotTo(currentCFrame)
                        end
                        
                        -- Fade out using State.AnimalTransparency (increase from original to 1)
                        State.AnimalTransparency = originalTransparency + (1 - originalTransparency) * progress
                        
                        task.wait()
                    end
                    
                    if model and model.Parent then
                        model:Destroy()
                    end
                    
                    -- Restore original transparency
                    State.AnimalTransparency = originalTransparency
                    state.isDespawning = false
                    state.spawned = nil
                end)
            end
        end
    end

