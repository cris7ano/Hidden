-- FIX: 3D Model Icon with Idle Animation (ViewportFrame) - Using HiddenDupe method
function loadModelIntoViewport(viewport, animalName, mutation, position)
    position = position or "Shoulder"
    
    warn("Loading model: " .. tostring(animalName))

    -- Clear previous model
    for _, child in ipairs(viewport:GetChildren()) do
        if child:IsA("Model") then child:Destroy() end
        if child:IsA("Camera") then child:Destroy() end
    end

    -- Get the model from Shared.Animals (correct method for HiddenFun)
    local sharedAnimals
    pcall(function()
        sharedAnimals = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animals"))
    end)

    local model = nil
    if sharedAnimals and type(sharedAnimals.GetAnimatedModel) == "function" then
        local success, result = pcall(function()
            return sharedAnimals:GetAnimatedModel(animalName, "Idle")
        end)
        if success and result then
            model = result:Clone()
            warn("Model loaded from Shared.Animals")
        end
    end

    -- Fallback: try ReplicatedStorage.Models.Animals (HiddenDupe method)
    if not model then
        local folder = ReplicatedStorage:FindFirstChild("Models")
        if folder then
            local animalsFolder = folder:FindFirstChild("Animals")
            if animalsFolder then
                local animalModel = animalsFolder:FindFirstChild(animalName)
                if animalModel then
                    model = animalModel:Clone()
                    warn("Model loaded from ReplicatedStorage.Models.Animals")
                end
            end
        end
    end

    if not model then
        warn("Model not found for: " .. tostring(animalName))
        return 
    end

    -- Parent model to viewport FIRST
    model.Parent = viewport
    warn("Model parented to viewport")

    -- Set up camera using workspace CurrentCamera as fallback
    local camera = viewport:FindFirstChildOfClass("Camera")
    if not camera then
        -- Try to create camera, if it fails use workspace camera
        local success, cam = pcall(function()
            return Instance.new("Camera")
        end)
        if success and cam then
            camera = cam
            camera.Parent = viewport
            viewport.CurrentCamera = camera
            warn("Camera created and set up")
        else
            -- Fallback: use workspace camera (read-only reference)
            warn("Using workspace camera as fallback")
            viewport.CurrentCamera = workspace.CurrentCamera
            camera = workspace.CurrentCamera
        end
    else
        viewport.CurrentCamera = camera
        warn("Using existing camera")
    end

    if camera then
        camera.FieldOfView = 35
    end

    -- Position camera based on model bounding box (HiddenDupe method)
    pcall(function()
        local cf, size = model:GetBoundingBox()
        local maxDim = math.max(size.X, size.Y, size.Z)
        local dist = math.max(maxDim * 2.2, 5)
        -- Look from the front (negative Z looking toward model center, slightly elevated)
        camera.CFrame = CFrame.new(
            cf.Position + Vector3.new(0, size.Y * 0.15, -dist),
            cf.Position
        )
        warn("Camera positioned")
    end)

    -- Apply mutation if needed
    if mutation and mutation ~= "None" and sharedAnimals and type(sharedAnimals.ApplyMutation) == "function" then
        pcall(function()
            sharedAnimals:ApplyMutation(model, animalName, mutation)
            warn("Mutation applied: " .. tostring(mutation))
        end)
    end

    -- Play idle animation (HiddenDupe method)
    pcall(function()
        local animRoot = ReplicatedStorage:FindFirstChild("Animations")
        if animRoot then
            local animalsFolder = animRoot:FindFirstChild("Animals")
            if animalsFolder then
                local animFolder = animalsFolder:FindFirstChild(animalName)
                if animFolder then
                    local idleAnim = animFolder:FindFirstChild("Idle")
                    if idleAnim and idleAnim:IsA("Animation") then
                        local controller = model:FindFirstChildWhichIsA("Humanoid") or model:FindFirstChildWhichIsA("AnimationController")
                        if controller then
                            local animator = controller:FindFirstChildWhichIsA("Animator")
                            if not animator then
                                animator = Instance.new("Animator")
                                animator.Parent = controller
                            end
                            local animTrack = animator:LoadAnimation(idleAnim)
                            animTrack.Looped = true
                            animTrack:Play()
                            warn("Animation playing")
                        end
                    end
                end
            end
        end
    end)

    viewport:SetAttribute("AnimalName", animalName)
    viewport:SetAttribute("Loaded", true)
    warn("Model load complete for: " .. tostring(animalName))
end

-- FPS Booster from XENTTHUB
local function processDescendant(obj)
    -- Disable particles/trails
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
        obj.Enabled = false
    end
    -- Disable effects (Explosion doesn't have Enabled, so skip it)
    if obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
        obj.Enabled = false
    end
    if obj:IsA("Explosion") then
        obj:Destroy()
    end
    -- Optimize parts
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.Plastic
        obj.Reflectance = 0
        obj.CastShadow = false
    end
    if removeAccessoriesActive and (obj:IsA("Accessory") or obj:IsA("Hat")) then
        obj:Destroy()
    end
end

local function optimizeLighting()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9000000488
    Lighting.Brightness = 1
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    for _, effect in pairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("BloomEffect") or effect:IsA("DepthOfFieldEffect") then
            effect.Enabled = false
        end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        processDescendant(obj)
    end
end

local function enableAntiLag()
    if antiLagActive then return end
    antiLagActive = true
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    optimizeLighting()
    descendantConnection = Workspace.DescendantAdded:Connect(processDescendant)
end

local function disableAntiLag()
    antiLagActive = false
    if descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
    end
end

local function removeAllAccessories()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            for _, obj in ipairs(player.Character:GetDescendants()) do
                if obj:IsA("Accessory") or obj:IsA("Hat") then
                    obj:Destroy()
                end
            end
        end
    end
end

local function enableRemoveAccessories()
    removeAccessoriesActive = true
    removeAllAccessories()
    if not accessoryConnection then
        accessoryConnection = Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                if removeAccessoriesActive then
                    for _, obj in ipairs(char:GetDescendants()) do
                        if obj:IsA("Accessory") or obj:IsA("Hat") then
                            obj:Destroy()
                        end
                    end
                end
            end)
        end)
    end
    if descendantConnection then descendantConnection:Disconnect() end
    descendantConnection = Workspace.DescendantAdded:Connect(processDescendant)
end

local function disableRemoveAccessories()
    removeAccessoriesActive = false
    if accessoryConnection then
        accessoryConnection:Disconnect()
        accessoryConnection = nil
    end
end

